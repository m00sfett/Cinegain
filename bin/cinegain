#!/usr/bin/env python3
"""
cinegain - CLI tool for Cinegain Realtime Film Audio Processor.

Controls the PipeWire filter-chain, live-adjusts parameters, loads presets,
routes applications (each with its own profile) and resets everything.
User state lives in ~/.config/cinegain/ (state.json, user_presets.json,
apps.json, config.json).
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import time

__version__ = "0.2.0"

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if os.path.exists(os.path.join(SCRIPT_DIR, "..", "share", "cinegain")):
    BASE_DIR = os.path.join(SCRIPT_DIR, "..", "share", "cinegain")
elif os.path.exists("/usr/share/cinegain"):
    BASE_DIR = "/usr/share/cinegain"
elif os.path.exists(os.path.expanduser("~/.local/share/cinegain/ui")):
    BASE_DIR = os.path.expanduser("~/.local/share/cinegain")
else:
    BASE_DIR = os.path.abspath(os.path.join(SCRIPT_DIR, ".."))
# A source checkout next to this script always wins over installed copies.
if os.path.exists(os.path.join(SCRIPT_DIR, "..", "ui", "cinegain_paths.py")):
    BASE_DIR = os.path.abspath(os.path.join(SCRIPT_DIR, ".."))

os.environ.setdefault("CINEGAIN_BASE_DIR", os.path.abspath(BASE_DIR))
sys.path.insert(0, os.path.join(os.path.abspath(BASE_DIR), "ui"))

import cinegain_paths as paths  # noqa: E402
from cinegain_profiles import (  # noqa: E402
    DEFAULT_PARAMS,
    STANDARD_SINK,
    ProfileCatalog,
    SinkProcesses,
    find_node_id,
    normalize_params,
    push_params,
    sink_name,
    wait_for_node,
)
from cinegain_pulse import PulseControl, clean_wireplumber_targets  # noqa: E402
from cinegain_registry import PROFILE_OFF, PROFILE_STANDARD, AppRegistry  # noqa: E402
from cinegain_reset import reset_everything  # noqa: E402
from cinegain_router import Router  # noqa: E402

LEGACY_PID_FILE = "/tmp/cinegain.pid"
STANDARD_DESCRIPTION = "Cinegain (Filmton Dialog & Dynamik)"

PRESET_ALIASES = {
    "neutral": "clean_linear",
    "0db": "clean_linear",
    "+5db": "boost_5db",
    "+10db": "boost_10db",
    "+15db": "boost_15db",
    "+20db": "boost_20db",
    "+25db": "boost_25db",
    "movie_boost": "dialog_boost",
}


# -- persisted standard-profile state ------------------------------------------

def load_saved_state():
    """Loads persisted parameters and active preset of the standard profile."""
    state = {"preset": "dialog_boost", "params": dict(DEFAULT_PARAMS)}
    data = paths.read_json(paths.STATE_FILE, default={}) or {}
    if isinstance(data.get("params"), dict):
        state["params"].update(normalize_params(data["params"]))
    if "preset" in data:
        state["preset"] = data["preset"]
    return state


def save_state(params=None, preset=None):
    state = load_saved_state()
    if params:
        state["params"].update(normalize_params(params))
    if preset is not None:
        state["preset"] = preset
    try:
        paths.write_json_atomic(paths.STATE_FILE, state)
    except OSError as e:
        print(f"Warning: could not save state: {e}", file=sys.stderr)
    return state


def get_cinegain_node_id():
    return find_node_id(STANDARD_SINK)


def set_params_batch(node_id, param_dict, preset=None):
    """Persists parameters of the standard profile and applies them live if running."""
    save_state(params=param_dict, preset=preset)
    if not node_id:
        return True
    return push_params(node_id, normalize_params(param_dict))


def get_params(node_id):
    """Reads all cinegain:* parameters from PipeWire if running, otherwise from saved state."""
    if not node_id:
        return load_saved_state()["params"]
    try:
        out = subprocess.check_output(["pw-dump", str(node_id)], stderr=subprocess.DEVNULL)
        for obj in json.loads(out):
            for p in obj.get("info", {}).get("params", {}).get("Props", []):
                if isinstance(p, dict) and isinstance(p.get("params"), list):
                    it = iter(p["params"])
                    found = {}
                    for k, v in zip(it, it):
                        if isinstance(k, str) and k.startswith("cinegain:"):
                            if isinstance(v, bool):
                                v = 1.0 if v else 0.0
                            if isinstance(v, (int, float)):
                                found[k[len("cinegain:"):]] = round(float(v), 3)
                    if found:
                        return found
    except (subprocess.CalledProcessError, ValueError, OSError):
        pass
    return load_saved_state()["params"]


def make_router():
    return Router()


def standard_sinks():
    return SinkProcesses(ProfileCatalog())


# -- commands ----------------------------------------------------------------------

def cmd_start(args):
    node_id = get_cinegain_node_id()
    saved = load_saved_state()
    if node_id:
        set_params_batch(node_id, saved["params"], preset=saved.get("preset"))
        print(f"Cinegain is already running (Node ID: {node_id}).")
    else:
        print("Starting Cinegain PipeWire filter chain...")
        standard_sinks().start(PROFILE_STANDARD, params=saved["params"],
                               description=STANDARD_DESCRIPTION)
        node_id = wait_for_node(STANDARD_SINK)
        if not node_id:
            print("Failed to start Cinegain.", file=sys.stderr)
            return 1
        PulseControl().set_sink_volume_100(STANDARD_SINK)
        set_params_batch(node_id, saved["params"], preset=saved.get("preset"))
        print(f"Cinegain started successfully (Node ID: {node_id}).")
    if getattr(args, "route", False):
        apps = make_router().tick(active=True)
        n = sum(1 for a in apps if a.streams and a.profile != PROFILE_OFF)
        print(f"Routing applied to {n} playing application(s).")
    return 0


def _kill_legacy_processes():
    if os.path.exists(LEGACY_PID_FILE):
        try:
            with open(LEGACY_PID_FILE) as f:
                os.kill(int(f.read().strip()), signal.SIGTERM)
        except (OSError, ValueError):
            pass
        try:
            os.remove(LEGACY_PID_FILE)
        except OSError:
            pass
    try:
        out = subprocess.check_output(["ps", "-u", str(os.getuid()), "-o", "pid=,args="], text=True)
    except (subprocess.CalledProcessError, OSError):
        return
    for line in out.splitlines():
        if "pipewire -c" in line and ("cinegain" in line or "kinoton" in line):
            try:
                os.kill(int(line.strip().split()[0]), signal.SIGTERM)
            except (OSError, ValueError):
                pass


def cmd_stop(args):
    node_id = get_cinegain_node_id()
    if node_id:
        live = get_params(node_id)
        if live:
            save_state(params=live)
    make_router().release_all()
    standard_sinks().stop(PROFILE_STANDARD)
    _kill_legacy_processes()
    clean_wireplumber_targets(paths.WIREPLUMBER_STREAM_PROPS)
    for _ in range(15):
        if get_cinegain_node_id() is None:
            break
        time.sleep(0.1)
    print("Cinegain stopped.")
    return 0


def cmd_status(args):
    node_id = get_cinegain_node_id()
    saved = load_saved_state()
    params = get_params(node_id) if node_id else saved["params"]
    running_profiles = sorted(standard_sinks().running() - {PROFILE_STANDARD})
    if getattr(args, "json", False):
        print(json.dumps({
            "active": bool(node_id),
            "node_id": node_id,
            "preset": saved.get("preset"),
            "params": params,
            "profile_sinks": running_profiles,
            "version": __version__,
        }))
        return 0 if node_id else 1
    if node_id:
        print(f"Cinegain status: ACTIVE (Node ID: {node_id})")
        print("\nCurrent Parameters:")
    else:
        print("Cinegain status: INACTIVE")
        print("\nSaved Parameters (will be applied on start):")
    for k, v in sorted(params.items()):
        print(f"  {k:18} = {v}")
    if running_profiles:
        print("\nProfile sinks running: " + ", ".join(running_profiles))
    return 0 if node_id else 1


def _set_and_report(updates, preset):
    node_id = get_cinegain_node_id()
    return set_params_batch(node_id, updates, preset=preset)


def cmd_set(args):
    short_p = args.param.replace("cinegain:", "")
    updates = {short_p: args.value}
    if short_p != "bypass":
        updates["bypass"] = 0.0
    if short_p == "lev_max_boost_db":
        updates["leveler"] = 1.0 if float(args.value) > 0.05 else 0.0
    ok = _set_and_report(updates, "custom")
    if ok:
        print(f"Set {args.param} = {args.value}")
    else:
        print(f"Failed to set {args.param}", file=sys.stderr)
    return 0 if ok else 1


def cmd_batch(args):
    try:
        raw = json.loads(args.json_params)
        updates = normalize_params(raw)
    except (ValueError, AttributeError) as e:
        print(f"Invalid JSON for batch: {e}", file=sys.stderr)
        return 1
    updates.setdefault("bypass", 0.0)
    if "lev_max_boost_db" in updates and "leveler" not in updates:
        updates["leveler"] = 1.0 if updates["lev_max_boost_db"] > 0.05 else 0.0
    return 0 if _set_and_report(updates, args.preset_id or "custom") else 1


def cmd_preset(args):
    presets = ProfileCatalog().factory()
    key = PRESET_ALIASES.get(args.name.lower(), args.name)
    if key not in presets:
        print(f"Unknown preset '{args.name}'. Available: {', '.join(presets)}", file=sys.stderr)
        return 1
    print(f"Applying preset: {presets[key]['name']}...")
    if _set_and_report(presets[key]["params"], key):
        print("Preset applied successfully.")
        return 0
    print("Failed to apply preset.", file=sys.stderr)
    return 1


def cmd_route(args):
    if not get_cinegain_node_id():
        print("Cinegain is not active. Start it first with 'cinegain start'.", file=sys.stderr)
        return 1
    apps = make_router().tick(active=True)
    for a in apps:
        if a.streams:
            print(f"  {a.label:28} {a.profile:14} -> {a.sink}")
    return 0


def cmd_watch(args):
    """Keeps routing applied without the GUI (Ctrl+C to stop)."""
    router = make_router()
    print("Watching audio streams (Ctrl+C to stop)...")
    try:
        while True:
            router.tick(active=bool(get_cinegain_node_id()))
            time.sleep(args.interval)
    except KeyboardInterrupt:
        router.registry.flush(force=True)
        print()
    return 0


def _resolve_app(registry, needle):
    needle_l = needle.lower()
    exact = [e for e in registry.entries() if needle_l in (e["key"], e["label"].lower(), e["name"].lower(), e["binary"].lower())]
    if len(exact) == 1:
        return exact[0]
    partial = [e for e in registry.entries() if needle_l in e["label"].lower() or needle_l in e["key"]]
    if len(partial) == 1:
        return partial[0]
    candidates = exact or partial
    if candidates:
        print("Ambiguous application, candidates: " + ", ".join(e["key"] for e in candidates), file=sys.stderr)
    else:
        print(f"Unknown application '{needle}'. See 'cinegain apps'.", file=sys.stderr)
    return None


def cmd_apps(args):
    registry = AppRegistry()
    catalog = ProfileCatalog()
    action = args.action or "list"
    if action == "list":
        entries = sorted(registry.entries(), key=lambda e: -e["last_seen"])
        if args.json:
            print(json.dumps(entries, ensure_ascii=False))
            return 0
        if not entries:
            print("No applications known yet. They appear as soon as they play audio.")
            return 0
        for e in entries:
            seen = time.strftime("%Y-%m-%d %H:%M", time.localtime(e["last_seen"]))
            print(f"  {e['label']:28} {e['profile']:14} last heard {seen}   [{e['key']}]")
        return 0
    if not args.app:
        print(f"'cinegain apps {action}' needs an application name.", file=sys.stderr)
        return 2
    entry = _resolve_app(registry, args.app)
    if entry is None:
        return 1
    if action == "set":
        profile = PRESET_ALIASES.get((args.profile or "").lower(), args.profile)
        if not profile or not catalog.exists(profile):
            names = ", ".join(pid for pid, _ in catalog.choices())
            print(f"Unknown profile '{args.profile}'. Available: {names}", file=sys.stderr)
            return 1
        registry.set_profile(entry["key"], profile)
        print(f"{entry['label']}: {profile}")
        if get_cinegain_node_id():
            make_router().tick(active=True)
        return 0
    if action == "rename":
        registry.rename(entry["key"], args.profile or "")
        print(f"Renamed to: {registry.get(entry['key'])['label']}")
        return 0
    if action == "forget":
        registry.forget(entry["key"])
        print(f"Forgot {entry['label']}.")
        return 0
    return 2


def cmd_profiles(args):
    catalog = ProfileCatalog()
    running = standard_sinks().running()
    for pid, name in catalog.choices():
        mark = ""
        if pid == PROFILE_STANDARD and get_cinegain_node_id():
            mark = "  (running)"
        elif pid in running:
            mark = f"  (running: {sink_name(pid)})"
        print(f"  {pid:14} {name}{mark}")
    return 0


def cmd_profile_sync(args):
    """Pushes the current parameters of a profile to its running sink."""
    catalog = ProfileCatalog()
    params = catalog.params(args.profile)
    if params is None:
        # The profile vanished (slot cleared): drop its apps back to standard.
        AppRegistry().replace_profile(args.profile, PROFILE_STANDARD)
        standard_sinks().stop(args.profile)
        return 0
    node_id = find_node_id(sink_name(args.profile))
    if node_id:
        push_params(node_id, params)
    return 0


def cmd_reset(args):
    if not args.yes:
        if not sys.stdin.isatty():
            print("Refusing to reset without --yes in a non-interactive shell.", file=sys.stderr)
            return 2
        answer = input("Reset ALL Cinegain settings, presets and application rules? [y/N] ")
        if answer.strip().lower() not in ("y", "yes", "j", "ja"):
            print("Aborted.")
            return 1
    was_running = bool(get_cinegain_node_id())
    report = reset_everything(sinks=standard_sinks(), backup=not args.no_backup)
    if was_running:
        cmd_stop(argparse.Namespace())
        # cmd_stop saved the live parameters again; drop them before restarting.
        try:
            os.remove(paths.STATE_FILE)
        except FileNotFoundError:
            pass
        cmd_start(argparse.Namespace(route=False))
    if args.json:
        print(json.dumps(report))
        return 0
    print("Cinegain has been reset to factory settings.")
    if report["backup"]:
        print(f"Backup of the previous state: {report['backup']}")
    print(f"Streams moved back to hardware: {report['streams_moved']}, "
          f"volumes restored: {report['volumes_restored']}")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description="Cinegain Film Audio Control CLI")
    parser.add_argument("--version", "-v", action="version", version=f"Cinegain {__version__}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_start = sub.add_parser("start", help="Start the Cinegain filter chain")
    p_start.add_argument("--route", "-r", action="store_true", help="Apply application routing")

    sub.add_parser("stop", help="Stop Cinegain and release all streams")

    p_status = sub.add_parser("status", help="Show status and parameter values")
    p_status.add_argument("--json", action="store_true", help="Output as JSON")

    sub.add_parser("route", help="Apply application routing once")

    p_watch = sub.add_parser("watch", help="Keep applying application routing (no GUI needed)")
    p_watch.add_argument("--interval", type=float, default=1.5, help="Seconds between scans")

    p_set = sub.add_parser("set", help="Live-adjust a parameter of the standard profile")
    p_set.add_argument("param", help="Parameter name (e.g. input_db, dialog_db)")
    p_set.add_argument("value", type=float, help="Value to set")

    p_batch = sub.add_parser("batch", help="Batch-set parameters as JSON dict")
    p_batch.add_argument("json_params", help="JSON dictionary of parameter names to values")
    p_batch.add_argument("--preset-id", dest="preset_id", default="custom", help="Preset identifier")

    p_preset = sub.add_parser("preset", help="Load a factory preset into the standard profile")
    p_preset.add_argument("name", help="Preset name (clean_linear, boost_5db..boost_25db, dialog_boost, ...)")

    p_apps = sub.add_parser("apps", help="List known applications or change their profile")
    p_apps.add_argument("action", nargs="?", choices=["list", "set", "rename", "forget"])
    p_apps.add_argument("app", nargs="?", help="Application (label, name, binary or key)")
    p_apps.add_argument("profile", nargs="?", help="Profile id for 'set', new label for 'rename'")
    p_apps.add_argument("--json", action="store_true", help="Output list as JSON")

    sub.add_parser("profiles", help="List usable profiles")

    p_sync = sub.add_parser("profile-sync", help="Push a profile's parameters to its running sink")
    p_sync.add_argument("profile")

    p_reset = sub.add_parser("reset", help="Reset everything to factory settings (with backup)")
    p_reset.add_argument("--yes", "-y", action="store_true", help="Do not ask for confirmation")
    p_reset.add_argument("--no-backup", action="store_true", help="Skip the backup copy")
    p_reset.add_argument("--json", action="store_true", help="Output report as JSON")

    args = parser.parse_args(argv)
    handlers = {
        "start": cmd_start,
        "stop": cmd_stop,
        "status": cmd_status,
        "route": cmd_route,
        "watch": cmd_watch,
        "set": cmd_set,
        "batch": cmd_batch,
        "preset": cmd_preset,
        "apps": cmd_apps,
        "profiles": cmd_profiles,
        "profile-sync": cmd_profile_sync,
        "reset": cmd_reset,
    }
    return handlers[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
