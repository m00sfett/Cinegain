#!/usr/bin/env python3
"""
cinegain - CLI tool for Cinegain Realtime Film Audio Processor.

Controls the PipeWire filter-chain, live-adjusts parameters, loads presets,
routes applications (each with its own profile) and resets everything.
User state lives in ~/.config/cinegain/ (state.json, user_presets.json,
apps.json, config.json).
"""
import argparse
import json
import os
import signal
import subprocess
import sys
import time

__version__ = "0.5.1"

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if os.path.exists(os.path.join(SCRIPT_DIR, "..", "share", "cinegain")):
    BASE_DIR = os.path.join(SCRIPT_DIR, "..", "share", "cinegain")
elif os.path.exists("/usr/share/cinegain"):
    BASE_DIR = "/usr/share/cinegain"
elif os.path.exists(os.path.expanduser("~/.local/share/cinegain/ui")):
    BASE_DIR = os.path.expanduser("~/.local/share/cinegain")
else:
    BASE_DIR = os.path.abspath(os.path.join(SCRIPT_DIR, ".."))
# A source checkout next to this script always wins over installed copies.
if os.path.exists(os.path.join(SCRIPT_DIR, "..", "ui", "cinegain_paths.py")):
    BASE_DIR = os.path.abspath(os.path.join(SCRIPT_DIR, ".."))

os.environ.setdefault("CINEGAIN_BASE_DIR", os.path.abspath(BASE_DIR))
sys.path.insert(0, os.path.join(os.path.abspath(BASE_DIR), "ui"))

import cinegain_log  # noqa: E402
from cinegain_lock import RouterLock  # noqa: E402
import cinegain_modes as modes  # noqa: E402
import cinegain_overdrive as overdrive  # noqa: E402
import cinegain_paths as paths  # noqa: E402
from cinegain_profiles import (  # noqa: E402
    DEFAULT_PARAMS,
    PROFILE_STANDARD,
    STANDARD_SINK,
    ProfileCatalog,
    SinkProcesses,
    cinegain_pipewire_pids,
    find_node_id,
    normalize_params,
    push_params,
    sink_name,
    wait_for_node,
)
from cinegain_pulse import PulseControl, clean_wireplumber_targets  # noqa: E402
from cinegain_registry import AppRegistry  # noqa: E402
from cinegain_reset import reset_everything  # noqa: E402
from cinegain_router import Router  # noqa: E402

log = cinegain_log.get("cli")

LEGACY_PID_FILE = "/tmp/cinegain.pid"
STANDARD_DESCRIPTION = "Cinegain (Filmton Dialog & Dynamik)"

PRESET_ALIASES = {
    "neutral": "clean_linear",
    "0db": "clean_linear",
    "+3db": "boost_3db",
    "+6db": "boost_6db",
    "+9db": "boost_9db",
    "+12db": "boost_12db",
    "+15db": "boost_15db",
    "movie_boost": "dialog_boost",
}


# -- persisted standard-profile state ------------------------------------------

def load_saved_state():
    """Standard's saved setting: mode, both value sets, effective params and preset id."""
    return modes.load_standard()


def save_state(params=None, preset=None, mode=None):
    """Merges values into Standard's active (or the given) mode and saves it."""
    state = load_saved_state()
    new_mode = mode if mode in modes.MODES else state["mode"]
    values = {k: v for k, v in normalize_params(params).items() if k not in ("bypass", "leveler")}
    sets = modes.apply_values(new_mode, state["sets"], values) if values else state["sets"]
    try:
        return modes.save_standard(new_mode, sets, preset)
    except OSError as e:
        print(f"Warning: could not save state: {e}", file=sys.stderr)
        return state


def get_cinegain_node_id():
    return find_node_id(STANDARD_SINK)


def set_params_batch(node_id, param_dict, preset=None, mode=None):
    """Persists values of Standard's active mode and applies the effective set live if running."""
    state = save_state(params=param_dict, preset=preset, mode=mode)
    if not node_id:
        return True
    live = dict(state["params"])
    if "bypass" in normalize_params(param_dict):
        live["bypass"] = normalize_params(param_dict)["bypass"]
    return push_params(node_id, live)


def get_params(node_id):
    """Reads all cinegain:* parameters from PipeWire if running, otherwise from saved state."""
    if not node_id:
        return load_saved_state()["params"]
    try:
        out = subprocess.check_output(["pw-dump", str(node_id)], stderr=subprocess.DEVNULL)
        for obj in json.loads(out):
            for p in obj.get("info", {}).get("params", {}).get("Props", []):
                if isinstance(p, dict) and isinstance(p.get("params"), list):
                    it = iter(p["params"])
                    found = {}
                    for k, v in zip(it, it):
                        if isinstance(k, str) and k.startswith("cinegain:"):
                            if isinstance(v, bool):
                                v = 1.0 if v else 0.0
                            if isinstance(v, (int, float)):
                                found[k[len("cinegain:"):]] = round(float(v), 3)
                    if found:
                        return found
    except (subprocess.CalledProcessError, ValueError, OSError):
        pass
    return load_saved_state()["params"]


def make_router():
    return Router()


def standard_sinks():
    return SinkProcesses()


# -- commands ----------------------------------------------------------------------

def cmd_start(args):
    node_id = get_cinegain_node_id()
    saved = load_saved_state()
    if node_id:
        set_params_batch(node_id, saved["params"], preset=saved.get("preset"))
        print(f"Cinegain is already running (Node ID: {node_id}).")
    else:
        print("Starting Cinegain PipeWire filter chain...")
        standard_sinks().start(PROFILE_STANDARD, params=saved["params"],
                               description=STANDARD_DESCRIPTION)
        node_id = wait_for_node(STANDARD_SINK)
        if not node_id:
            print("Failed to start Cinegain.", file=sys.stderr)
            return 1
        PulseControl().set_sink_volume_100(STANDARD_SINK)
        set_params_batch(node_id, saved["params"], preset=saved.get("preset"))
        print(f"Cinegain started successfully (Node ID: {node_id}).")
    if getattr(args, "route", False):
        apps = make_router().tick(active=True)
        n = sum(1 for a in apps if a.streams and a.enabled)
        print(f"Routing applied to {n} playing program(s).")
    return 0


def _kill_legacy_processes():
    """Stops Cinegain filter chains started by older versions (or left behind)."""
    try:
        os.remove(LEGACY_PID_FILE)
    except OSError:
        pass
    for pid in cinegain_pipewire_pids():
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass


def cmd_stop(args):
    if load_saved_state()["migrated"]:
        save_state()  # write the 0.4.0 format before the filter goes away
    make_router().release_all()
    standard_sinks().stop(PROFILE_STANDARD, "cinegain stop")
    _kill_legacy_processes()
    clean_wireplumber_targets(paths.WIREPLUMBER_STREAM_PROPS)
    for _ in range(15):
        if get_cinegain_node_id() is None:
            break
        time.sleep(0.1)
    print("Cinegain stopped.")
    return 0


def cmd_status(args):
    try:
        node_id = find_node_id(STANDARD_SINK, strict=True)
    except (subprocess.CalledProcessError, ValueError, OSError):
        if getattr(args, "json", False):
            print(json.dumps({"active": None, "error": "pw-dump failed", "version": __version__}))
        else:
            print("Cinegain status: UNKNOWN (pw-dump failed)", file=sys.stderr)
        return 2
    saved = load_saved_state()
    params = get_params(node_id) if node_id else saved["params"]
    running_profiles = sorted(standard_sinks().running() - {PROFILE_STANDARD})
    if getattr(args, "json", False):
        print(json.dumps({
            "active": bool(node_id),
            "node_id": node_id,
            "preset": saved.get("preset"),
            "mode": saved["mode"],
            "sets": saved["sets"],
            "params": params,
            "overdrive": overdrive.is_on(),
            "profile_sinks": running_profiles,
            "version": __version__,
        }))
        return 0 if node_id else 1
    if node_id:
        print(f"Cinegain status: ACTIVE (Node ID: {node_id})")
        print("\nCurrent Parameters:")
    else:
        print("Cinegain status: INACTIVE")
        print("\nSaved Parameters (will be applied on start):")
    print(f"  mode               = {saved['mode']}")
    print(f"  overdrive          = {'ON (up to +40 dB)' if overdrive.is_on() else 'off (up to +15 dB)'}")
    for k, v in sorted(params.items()):
        print(f"  {k:18} = {v}")
    if running_profiles:
        print("\nProfile sinks running: " + ", ".join(running_profiles))
    return 0 if node_id else 1


def _set_and_report(updates, preset, mode=None):
    node_id = get_cinegain_node_id()
    return set_params_batch(node_id, updates, preset=preset, mode=mode)


def cmd_set(args):
    short_p = args.param.replace("cinegain:", "")
    updates = {short_p: args.value}
    if short_p != "bypass":
        updates["bypass"] = 0.0
    if short_p == "lev_max_boost_db":
        updates["leveler"] = 1.0 if float(args.value) > 0.05 else 0.0
    ok = _set_and_report(updates, "custom")
    if ok:
        print(f"Set {args.param} = {args.value}")
    else:
        print(f"Failed to set {args.param}", file=sys.stderr)
    return 0 if ok else 1


def cmd_batch(args):
    try:
        raw = json.loads(args.json_params)
        updates = normalize_params(raw)
    except (ValueError, AttributeError) as e:
        print(f"Invalid JSON for batch: {e}", file=sys.stderr)
        return 1
    updates.setdefault("bypass", 0.0)
    return 0 if _set_and_report(updates, args.preset_id or "custom", mode=args.mode) else 1


def cmd_preset(args):
    presets = ProfileCatalog().factory()
    key = PRESET_ALIASES.get(args.name.lower(), args.name)
    if key not in presets:
        print(f"Unknown preset '{args.name}'. Available: {', '.join(presets)}", file=sys.stderr)
        return 1
    print(f"Applying preset: {presets[key]['name']}...")
    mode = modes.preset_mode(key)
    if _set_and_report(modes.mode_values(mode, presets[key]["params"]), key, mode=mode):
        print("Preset applied successfully.")
        return 0
    print("Failed to apply preset.", file=sys.stderr)
    return 1


def cmd_route(args):
    if not get_cinegain_node_id():
        print("Cinegain is not active. Start it first with 'cinegain start'.", file=sys.stderr)
        return 1
    apps = make_router().tick(active=True)
    for a in apps:
        if a.streams:
            mode = "off" if not a.enabled else ("own" if a.own else "standard")
            print(f"  {a.label:28} {mode:10} -> {a.sink}")
    return 0


def cmd_watch(args):
    """Keeps routing applied without the GUI (Ctrl+C to stop)."""
    lock = RouterLock("watch")
    if not lock.acquire():
        print(f"Routing is already handled by {lock.holder() or 'another Cinegain process'} "
              "(the GUI or another `cinegain watch`); only one may run.", file=sys.stderr)
        return 1
    from cinegain_volume import VolumeGuard
    router = make_router()
    if overdrive.set_on(False):  # overdrive never survives a restart of the router owner
        _cap_to_normal_scale(router)
    router.guard = VolumeGuard(auto=bool(paths.config_get("volume_auto_reset", True)))
    print("Watching audio streams (Ctrl+C to stop)...")
    try:
        while True:
            router.tick(active=bool(get_cinegain_node_id()))
            deadline = time.time() + args.interval
            while time.time() < deadline:
                router.guard.step()  # smooth fade-ins of secretly lowered streams
                time.sleep(0.1)
    except KeyboardInterrupt:
        router.registry.flush(force=True)
        print()
    return 0


def _resolve_app(registry, needle):
    needle_l = needle.lower()
    exact = [e for e in registry.entries() if needle_l in (e["key"], e["label"].lower(), e["name"].lower(), e["binary"].lower())]
    if len(exact) == 1:
        return exact[0]
    partial = [e for e in registry.entries() if needle_l in e["label"].lower() or needle_l in e["key"]]
    if len(partial) == 1:
        return partial[0]
    candidates = exact or partial
    if candidates:
        print("Ambiguous application, candidates: " + ", ".join(e["key"] for e in candidates), file=sys.stderr)
    else:
        print(f"Unknown application '{needle}'. See 'cinegain apps'.", file=sys.stderr)
    return None


def _describe(entry):
    state = "on " if entry["enabled"] else "off"
    if entry["params"]:
        db = entry["params"].get("input_db", 0.0)
        setting = f"own {entry.get('mode') or ''} ({db:+.1f} dB)"
    else:
        setting = "follows Standard"
    return f"{state}  {setting}"


def cmd_apps(args):
    registry = AppRegistry()
    action = args.action or "list"
    if action == "list":
        entries = sorted(registry.entries(), key=lambda e: -e["last_seen"])
        if args.json:
            print(json.dumps(entries, ensure_ascii=False))
            return 0
        if not entries:
            print("No programs known yet. They appear as soon as they play audio.")
            return 0
        for e in entries:
            seen = time.strftime("%Y-%m-%d %H:%M", time.localtime(e["last_seen"]))
            print(f"  {e['label']:26} {_describe(e):26} last heard {seen}   [{e['key']}]")
        return 0
    if not args.app:
        print(f"'cinegain apps {action}' needs a program name.", file=sys.stderr)
        return 2
    entry = _resolve_app(registry, args.app)
    if entry is None:
        return 1
    key = entry["key"]
    router = None
    if action in ("on", "off"):
        registry.set_enabled(key, action == "on")
    elif action == "load":
        catalog = ProfileCatalog()
        template = PRESET_ALIASES.get((args.value or "").lower(), args.value)
        mode, values = catalog.template_setting(template) if template else (None, None)
        if template == PROFILE_STANDARD or mode is None:
            names = ", ".join(tid for tid, _ in catalog.templates())
            print(f"Unknown template '{args.value}'. Available: {names}", file=sys.stderr)
            return 1
        base = entry["sets"] or load_saved_state()["sets"]
        registry.set_setting(key, mode, modes.apply_values(mode, base, values))
        router = make_router()
        router.push_program_params(key)
    elif action == "standard":
        registry.set_params(key, None)
    elif action == "rename":
        registry.rename(key, args.value or "")
    elif action == "forget":
        registry.forget(key)
        print(f"Forgot {entry['label']}.")
        return 0
    else:
        return 2
    updated = registry.get(key)
    print(f"{updated['label']}: {_describe(updated)}")
    if get_cinegain_node_id():
        (router or make_router()).tick(active=True)
    return 0


def cmd_mode(args):
    """Shows or switches the mode of Standard (default) or of one program."""
    if not args.app:
        state = load_saved_state()
        if args.mode and args.mode != state["mode"]:
            if not set_params_batch(get_cinegain_node_id(), {}, mode=args.mode):
                print("Failed to switch the mode.", file=sys.stderr)
                return 1
            state = load_saved_state()
        print(f"Standard: {state['mode']}")
        return 0
    registry = AppRegistry()
    entry = _resolve_app(registry, args.app)
    if entry is None:
        return 1
    key = entry["key"]
    if args.mode and args.mode != entry["mode"]:
        sets = entry["sets"] or load_saved_state()["sets"]
        registry.set_setting(key, args.mode, sets)
        make_router().push_program_params(key)
        entry = registry.get(key)
    print(f"{entry['label']}: {entry['mode'] or 'follows Standard (' + load_saved_state()['mode'] + ')'}")
    return 0


def _save_standard_and_push(mode, sets):
    set_params_batch(get_cinegain_node_id(), sets[mode], mode=mode)


def cmd_volume_reset(args):
    """Full volume reset: hidden stream volumes to 0 dB, normal volumes 100 %, saved values cleaned."""
    key = None
    if args.app:
        entry = _resolve_app(AppRegistry(), args.app)
        if entry is None:
            return 1
        key = entry["key"]
    report = make_router().full_volume_reset(standard=(load_saved_state, _save_standard_and_push), only=key)
    if args.json:
        print(json.dumps(report, ensure_ascii=False))
        return 0
    for c in report["compensated"]:
        print(f"  {c['target']}: {c['hidden_db']:+.1f} dB back, Cinegain gain "
              f"{c['input_db'][0]:+.1f} -> {c['input_db'][1]:+.1f} dB")
    for f in report["faded"]:
        print(f"  {f['target']}: faded in from {f['hidden_db']:+.1f} dB")
    print(f"Normal stream volumes set to 100 %: {report['volumes_100']}")
    if report["backup"]:
        print(f"Saved WirePlumber volumes cleaned: {report['file_entries']} (backup {report['backup']})")
    return 0


OVERDRIVE_WARNING = """\
Overdrive raises the volume scale from +15 dB to +40 dB.
  - Above about +25 dB the limiter squeezes peaks hard: audible distortion.
  - Loud levels can damage hearing and speakers. Turn the system volume down first.
  - Overdrive ends when Cinegain restarts; values above +15 dB then drop to +15 dB.
Run again with --confirm to switch it on."""


def _cap_to_normal_scale(router=None):
    """After overdrive goes off: cap saved values to +15 dB and push them at once."""
    router = router or make_router()
    changed = modes.clamp_stored(router.registry, overdrive_on=False)
    if "standard" in changed:
        set_params_batch(get_cinegain_node_id(), {})
    for key in changed:
        if key != "standard":
            router.push_program_params(key)
    return changed


def cmd_overdrive(args):
    if args.action == "on":
        if not args.confirm:
            print(OVERDRIVE_WARNING, file=sys.stderr)
            return 2
        overdrive.set_on(True)
        print("Overdrive ON: volume and make-up reach up to +40 dB until Cinegain restarts.")
        return 0
    if args.action == "off":
        overdrive.set_on(False)
        changed = _cap_to_normal_scale()
        print("Overdrive off: scale up to +15 dB" + (f" (capped: {', '.join(changed)})" if changed else "."))
        return 0
    print("Overdrive: " + ("ON (up to +40 dB)" if overdrive.is_on() else "off (up to +15 dB)"))
    return 0


def _resolve_node(rows, needle):
    if str(needle).isdigit():
        hits = [r for r in rows if str(r["id"]) == str(needle)]
    else:
        n = str(needle).lower()
        hits = [r for r in rows if n in r["label"].lower() or n == r["key"] or n in r["node_name"].lower()]
    if len(hits) != 1:
        print(("Ambiguous node, candidates: " + ", ".join(f"{r['id']} {r['label']}" for r in hits))
              if hits else f"Unknown node '{needle}'. See 'cinegain volume list'.", file=sys.stderr)
        return None
    return hits[0]


def cmd_volume(args):
    """Hidden stream volumes: list, set (0-100 %) or reset (same as volume-reset)."""
    import cinegain_volume as vol
    if args.action == "reset":
        args.app = args.target
        return cmd_volume_reset(args)
    rows = vol.scan_analysis()
    if args.action == "set":
        if args.target is None or args.percent is None:
            print("Usage: cinegain volume set <node id | program> <percent 0-100>", file=sys.stderr)
            return 1
        row = _resolve_node(rows, args.target)
        if row is None:
            return 1
        if not row["editable"]:
            print(f"{row['label']} is a hardware output; Cinegain leaves it untouched.", file=sys.stderr)
            return 1
        value = max(0.0, min(100.0, args.percent)) / 100.0
        if value > row["hidden"] * 1.0001:
            print(f"{row['label']}: fading in from {vol.to_db(row['hidden']):+.1f} dB (at most 10 dB/s) ...")
        ok = vol.set_hidden(row["id"], value, row["label"], "cli", row["hidden"])
        print(f"{row['label']}: hidden volume {value * 100:.1f} %" if ok
              else f"Setting the hidden volume of {row['label']} failed.")
        return 0 if ok else 1
    if args.json:
        print(json.dumps(rows, ensure_ascii=False))
        return 0
    print(f"  {'id':>5}  {'kind':16} {'hidden':>9} {'normal':>7} {'saved':>9}  name")
    for r in rows:
        saved = "" if r["stored"] is None else f"{vol.to_db(r['stored']):+.1f} dB"
        print(f"  {r['id']:>5}  {r['kind']:16} {vol.to_db(r['hidden']):+7.1f} dB {r['normal'] * 100:6.0f}% "
              f"{saved:>9}  {r['label']}{'  (muted)' if r['mute'] else ''}")
    return 0


def cmd_templates(args):
    """Lists the presets and filled user slots that can be loaded into a program."""
    for tid, name in ProfileCatalog().templates():
        print(f"  {tid:14} {name}")
    running = sorted(standard_sinks().running() - {PROFILE_STANDARD})
    if running:
        print("\nPer-program sinks running: " + ", ".join(sink_name(p) for p in running))
    return 0


def cmd_reset(args):
    if not args.yes:
        if not sys.stdin.isatty():
            print("Refusing to reset without --yes in a non-interactive shell.", file=sys.stderr)
            return 2
        answer = input("Reset ALL Cinegain settings, presets and application rules? [y/N] ")
        if answer.strip().lower() not in ("y", "yes", "j", "ja"):
            print("Aborted.")
            return 1
    was_running = bool(get_cinegain_node_id())
    report = reset_everything(sinks=standard_sinks(), backup=not args.no_backup)
    if was_running:
        cmd_stop(argparse.Namespace())
        # cmd_stop saved the live parameters again; drop them before restarting.
        try:
            os.remove(paths.STATE_FILE)
        except FileNotFoundError:
            pass
        cmd_start(argparse.Namespace(route=False))
    if args.json:
        print(json.dumps(report))
        return 0
    print("Cinegain has been reset to factory settings.")
    if report["backup"]:
        print(f"Backup of the previous state: {report['backup']}")
    print(f"Streams moved back to hardware: {report['streams_moved']}, "
          f"volumes restored: {report['volumes_restored']}")
    return 0


def cmd_log(args):
    if args.path:
        print(paths.LOG_FILE)
        return 0
    lines = cinegain_log.tail(lines=max(1, args.lines))
    if not lines and not os.path.exists(paths.LOG_FILE):
        print(f"No log yet: {paths.LOG_FILE}", file=sys.stderr)
        if not args.follow:
            return 1
    sys.stdout.writelines(lines)
    sys.stdout.flush()
    if not args.follow:
        return 0
    try:
        with open(paths.LOG_FILE, "r", encoding="utf-8", errors="replace") as f:
            f.seek(0, os.SEEK_END)
            while True:
                line = f.readline()
                if line:
                    sys.stdout.write(line)
                    sys.stdout.flush()
                else:
                    time.sleep(0.3)
    except KeyboardInterrupt:
        return 0
    except OSError as e:
        print(f"Cannot read {paths.LOG_FILE}: {e}", file=sys.stderr)
        return 1


def main(argv=None):
    parser = argparse.ArgumentParser(description="Cinegain Film Audio Control CLI")
    parser.add_argument("--version", "-v", action="version", version=f"Cinegain {__version__}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_start = sub.add_parser("start", help="Start the Cinegain filter chain")
    p_start.add_argument("--route", "-r", action="store_true", help="Apply application routing")

    sub.add_parser("stop", help="Stop Cinegain and release all streams")

    p_status = sub.add_parser("status", help="Show status and parameter values")
    p_status.add_argument("--json", action="store_true", help="Output as JSON")

    sub.add_parser("route", help="Apply application routing once")

    p_watch = sub.add_parser("watch", help="Keep applying application routing (no GUI needed)")
    p_watch.add_argument("--interval", type=float, default=1.5, help="Seconds between scans")

    p_set = sub.add_parser("set", help="Live-adjust a parameter of the standard profile")
    p_set.add_argument("param", help="Parameter name (e.g. input_db, dialog_db)")
    p_set.add_argument("value", type=float, help="Value to set")

    p_batch = sub.add_parser("batch", help="Batch-set parameters as JSON dict")
    p_batch.add_argument("json_params", help="JSON dictionary of parameter names to values")
    p_batch.add_argument("--preset-id", dest="preset_id", default="custom", help="Preset identifier")
    p_batch.add_argument("--mode", choices=modes.MODES, help="Switch Standard to this mode first")

    p_mode = sub.add_parser("mode", help="Show or switch the mode (fixed / dynamic beta) of Standard or a program")
    p_mode.add_argument("mode", nargs="?", choices=modes.MODES, help="fixed or dynamic")
    p_mode.add_argument("--app", help="Program (label, name, binary or key); default: Standard")

    p_preset = sub.add_parser("preset", help="Load a factory preset into the standard profile")
    p_preset.add_argument("name", help="Preset name (clean_linear, boost_3db..boost_15db, dialog_boost, ...)")

    p_apps = sub.add_parser(
        "apps",
        help="List programs, switch them on/off, load a template or go back to Standard",
    )
    p_apps.add_argument("action", nargs="?",
                        choices=["list", "on", "off", "load", "standard", "rename", "forget"])
    p_apps.add_argument("app", nargs="?", help="Program (label, name, binary or key)")
    p_apps.add_argument("value", nargs="?", help="Template id for 'load', new label for 'rename'")
    p_apps.add_argument("--json", action="store_true", help="Output list as JSON")

    p_log = sub.add_parser("log", help="Show the debug log (path, last lines or follow)")
    p_log.add_argument("--lines", "-n", type=int, default=80, help="Number of lines to show")
    p_log.add_argument("--follow", "-f", action="store_true", help="Keep printing new lines")
    p_log.add_argument("--path", action="store_true", help="Only print the log file path")

    p_vreset = sub.add_parser("volume-reset", help="Full volume reset: undo secretly lowered stream volumes")
    p_vreset.add_argument("--app", help="Only this program")
    p_vreset.add_argument("--json", action="store_true", help="Output report as JSON")

    p_od = sub.add_parser("overdrive", help="Show or switch overdrive (volume scale up to +40 dB)")
    p_od.add_argument("action", nargs="?", choices=["on", "off", "status"], default="status")
    p_od.add_argument("--confirm", action="store_true", help="Confirm the overdrive warning")

    p_vol = sub.add_parser("volume", help="Hidden stream volumes: list, set or reset")
    p_vol.add_argument("action", nargs="?", choices=["list", "set", "reset"], default="list")
    p_vol.add_argument("target", nargs="?", help="Node id or program (set, reset)")
    p_vol.add_argument("percent", nargs="?", type=float, help="Hidden volume in percent (0-100) for set")
    p_vol.add_argument("--json", action="store_true", help="Output as JSON")

    sub.add_parser("templates", aliases=["profiles"], help="List presets and user slots")

    p_reset = sub.add_parser("reset", help="Reset everything to factory settings (with backup)")
    p_reset.add_argument("--yes", "-y", action="store_true", help="Do not ask for confirmation")
    p_reset.add_argument("--no-backup", action="store_true", help="Skip the backup copy")
    p_reset.add_argument("--json", action="store_true", help="Output report as JSON")

    args = parser.parse_args(argv)
    cinegain_log.setup("cli")
    if args.cmd not in ("status", "log"):  # status is polled by the GUI every 1.5 s
        log.info("cinegain %s", " ".join(sys.argv[1:] if argv is None else argv))
    handlers = {
        "start": cmd_start,
        "stop": cmd_stop,
        "status": cmd_status,
        "route": cmd_route,
        "watch": cmd_watch,
        "set": cmd_set,
        "batch": cmd_batch,
        "preset": cmd_preset,
        "apps": cmd_apps,
        "templates": cmd_templates,
        "profiles": cmd_templates,
        "reset": cmd_reset,
        "log": cmd_log,
        "mode": cmd_mode,
        "volume-reset": cmd_volume_reset,
        "volume": cmd_volume,
        "overdrive": cmd_overdrive,
    }
    try:
        return handlers[args.cmd](args)
    except Exception:
        log.exception("cinegain %s failed", args.cmd)
        raise


if __name__ == "__main__":
    sys.exit(main())
